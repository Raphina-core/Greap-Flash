{
  "publisher": "Raphina-core-12",
  "name": "greapflash",
  "displayName": "GreapFlash",
  "description": "Búsqueda difusa con ranking dentro del archivo activo de VS Code",
  "version": "1.0.2",
  "license": "MIT",
  "keywords": ["fuzzy", "fzf", "search", "find", "quick open", "neovim", "telescope"],
  "icon": "greapflash-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "greapflash.search", "title": "GreapFlash: Buscar en archivo actual" }
    ],
    "keybindings": [
      { "command": "greapflash.search", "key": "ctrl+alt+g", "mac": "cmd+alt+g", "when": "editorTextFocus" }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:core": "npm run compile && node --test \"out/search/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "1.85.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "18.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "repository": {
  "type": "git",
  "url": "https://github.com/Raphina-core/Greap-Flash.git"
}
}
